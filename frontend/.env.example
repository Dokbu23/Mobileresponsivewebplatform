VITE_API_BASE=http://localhost:8000
VITE_API_URL=http://localhost:8000/api

# Google Maps Directions API — replace with your key from Google Cloud Console
# Required APIs: Directions API, Maps JavaScript API (with geometry library)
VITE_GOOGLE_MAPS_API_KEY=

# Mapbox Directions API (Accurate Navigation & Road Survey)
VITE_MAPBOX_ACCESS_TOKEN=

# Google Gemini AI API Key (AI Commute & Transit Guide)
VITE_GEMINI_API_KEY=

# Google OAuth 2.0 Client ID (Public identifier for web auth)
VITE_GOOGLE_CLIENT_ID=1077786109897-sdk0rm0kap4af7r481b6c6ve2jog4pc8.apps.googleusercontent.com

# Video compression settings
# Browser processing limit: up to 2 GB (WebCodecs streaming compression)
# Videos are compressed adaptively: small (<50MB) preserve 1080p, medium/large use 720p, xlarge (500MB+) use streaming
# Set higher for more processing, lower for faster/less memory usage
# Default: 2048 MB (2GB) - can be reduced for memory-constrained devices
VITE_VIDEO_PROCESS_MAX_INPUT_MB=2048

# Maximum video duration for browser processing (seconds)
# Default: 600 seconds (10 minutes)
VITE_VIDEO_PROCESS_MAX_DURATION_SECONDS=600
