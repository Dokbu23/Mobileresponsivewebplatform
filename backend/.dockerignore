# Exclude EVERYTHING by default
*

# Then explicitly INCLUDE only what Laravel needs

# Core files
!composer.json
!composer.lock
!artisan
!build.sh

# Application directories
!app/
app/.gitignore

!config/
!routes/
!resources/
!bootstrap/

# Database
!database/
database/database.sqlite

# Public (but not storage symlinks)
!public/
public/storage

# Storage skeleton only (not cached data)
!storage/
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
